# PaperToCAD - AI Circuit Assistant Configuration (Optional)
# If left blank, the assistant runs in offline mode using the local topological calculation engine.

# Option 1: Groq Cloud (Recommended for fast inference)
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# Option 2: OpenAI API
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Option 3: Local / Self-Hosted OpenAI-Compatible Server (e.g., Ollama, vLLM, LM Studio)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=

