# PaperToCAD - AI Circuit Assistant Configuration
# Select provider: 'groq', 'openai', or leave blank for local offline engine.
LLM_PROVIDER=groq

# Option 1: Groq Cloud (Recommended: Ultra-fast & Free)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Option 2: OpenAI API (Requires prepaid credit balance at platform.openai.com)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Option 3: Local Offline Model (Ollama, LM Studio) - 100% free & local
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=
